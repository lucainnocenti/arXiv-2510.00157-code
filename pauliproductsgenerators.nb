Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"notObviouslyWrongPairs", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"pairsOfAbelian4qubitGenerators", ",", 
       RowBox[{"Not", "@*", "haveAllIInSomeCol"}]}], "]"}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"fullRankQ", "@", 
                RowBox[{"stabiliserFromGenerators", "@", "generators"}]}], 
               ",", 
               RowBox[{"Framed", "[", 
                RowBox[{"#", ",", 
                 RowBox[{"Background", "->", "LightBlue"}]}], "]"}], ",", 
               "#"}], "]"}], "&"}], "@", 
            RowBox[{"prettifyPaulis", "@", "generators"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"adjacencyGraphFromPaulis", "[", 
            RowBox[{"#", ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", "2"}], "}"}]}], "]"}]}], 
          "\[IndentingNewLine]", "}"}], "&"}], "@", 
        RowBox[{"convertToGraphState", "@", 
         RowBox[{
         "fullGeneratorsFromCosetsGenerators", "@", "generators"}]}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"generators", ",", 
         RowBox[{
          RowBox[{"RandomSample", "[", "notObviouslyWrongPairs", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{";;", "40"}], "]"}], "]"}]}], "}"}]}], 
      "\[IndentingNewLine]", "]"}], "//", 
     RowBox[{"SortBy", "@", "Last"}]}], "//", 
    RowBox[{"Map", "[", 
