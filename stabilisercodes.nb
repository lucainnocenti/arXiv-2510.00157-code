\\\"XYZI\\\"}] = \>\"", ",", 
      RowBox[{"pauliWeight", "[", 
       RowBox[{"pauliBinary", "[", "\"\<IIII\>\"", "]"}], "]"}], ",", 
      "\"\<, \>\"", ",", 
      RowBox[{"pauliWeight", "[", 
       RowBox[{"pauliBinary", "[", "\"\<XIII\>\"", "]"}], "]"}], ",", 
