              RowBox[{"(", 
               RowBox[{"return", " ", "untouched", " ", "characters"}], 
               ")"}]}], ",", " ", 
             RowBox[{
             "but", " ", "still", " ", "count", " ", "the", " ", "generator", 
              " ", "as", " ", "\"\<used\>\""}]}], " ", "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Length", "@", "xyposs"}], "==", "1"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"characters", ",", 
             RowBox[{"DeleteCases", "[", 
              RowBox[{"availableGens", ",", 
               RowBox[{"xyposs", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", "appliedH"}], 
            "}"}], ",", "\[IndentingNewLine]", "True", ",", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
             RowBox[{"if", " ", 
              RowBox[{"we", "'"}], "re", " ", "here"}], ",", " ", 
             RowBox[{
              RowBox[{
              "presumably", " ", "some", " ", "column", " ", "contains", " ", 
               "NO", " ", 
               RowBox[{"X", "/", "Y"}]}], ";", " ", 
              RowBox[{
              "we", " ", "can", " ", "apply", " ", "an", " ", "H", " ", 
               "then", " ", "to", " ", "fix", " ", "it"}]}]}], " ", "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"appliedH", "==", "True"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{
               "\"\<This shouldn't happen: there seems to be 0 X/Ys (even \
after applying an H) at col \>\"", "<>", 
                RowBox[{"ToString", "@", "col"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"Abort", "[", "]"}]}], ",", "\[IndentingNewLine]", 
             RowBox[{"(*", " ", 
              RowBox[{
              "otherwise", " ", "apply", " ", "H", " ", "and", " ", "move", 
               " ", "on"}], " ", "*)"}], "\[IndentingNewLine]", 
             RowBox[{"fixXYatCol", "[", 
              RowBox[{
               RowBox[{"localHgate", "[", 
                RowBox[{"characters", ",", "col"}], "]"}], ",", "col", ",", 
               "availableGens", ",", "True"}], "]"}]}], "\[IndentingNewLine]",
             "]"}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
        "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ClearAll", "[", "fixStrayYs", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"fixStrayYs", "[", 
     RowBox[{"characters", ":", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", "__String", "}"}], ".."}], "}"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"rollingChars", "=", "characters"}], ",", "YsInCol", ",", 
        RowBox[{"whereWeAppliedS", "=", 
         RowBox[{"{", "}"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"YsInCol", "=", 
           RowBox[{"Cases", "[", 
            RowBox[{
             RowBox[{"rollingChars", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "col"}], "]"}], "]"}], ",", "\"\<Y\>\""}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"Which", "[", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{"if", " ", 
             RowBox[{"there", "'"}], "s", " ", "a", " ", "single", " ", "Y", 
             " ", "we", " ", "fix", " ", "it", " ", "and", " ", "remember", 
             " ", "where", " ", "we", " ", "applied", " ", "the", " ", "S"}], 
            " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "@", "YsInCol"}], "==", "1"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"AppendTo", "[", 
              RowBox[{"whereWeAppliedS", ",", "col"}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"rollingChars", "=", 
              RowBox[{"localSgate", "[", 
               RowBox[{"rollingChars", ",", "col"}], "]"}]}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", " ", 
             RowBox[{
              RowBox[{"check", " ", "that", " ", "there", " ", 
               RowBox[{"isn", "'"}], "t", " ", "more", " ", "than", " ", "1", 
               " ", "Y"}], ",", " ", 
              RowBox[{"which", " ", 
               RowBox[{"shouldn", "'"}], "t", " ", "happen"}]}], " ", "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Length", "@", "YsInCol"}], ">", "1"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{
              "\"\<This shouldn't happen; there should either 0 or 1 Y for \
each column (failed at col \>\"", "<>", 
               RowBox[{"ToString", "@", "col"}], "<>", "\"\<)\>\""}], "]"}], 
             ";", "\[IndentingNewLine]", 
             RowBox[{"Return", "@", "$Failed"}]}]}], "\[IndentingNewLine]", 
           "]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"col", ",", 
           RowBox[{"Length", "@", 
            RowBox[{"First", "@", "characters"}]}]}], "}"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"rollingChars", ",", "whereWeAppliedS"}], "}"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ClearAll", "[", "sortGeneratorsByXPosition", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"sortGeneratorsByXPosition", "[", 
     RowBox[{"generators", ":", 
      RowBox[{"{", "__String", "}"}]}], "]"}], ":=", 
    RowBox[{"generators", "//", 
     RowBox[{"SortBy", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"StringContainsQ", "[", 
         RowBox[{"#", ",", "\"\<X\>\""}], "]"}], "&&", 
        RowBox[{
         RowBox[{"StringPosition", "[", 
          RowBox[{"#", ",", "\"\<X\>\""}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], "&"}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ClearAll", "[", "convertToGraphState", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "convertToGraphState", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<bePedantic\>\"", "->", "False"}], ",", 
     RowBox[{"\"\<systemQubits\>\"", "->", "None"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"convertToGraphState", "[", 
     RowBox[{
      RowBox[{"generators", ":", 
       RowBox[{"{", "__String", "}"}]}], ",", 
      RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"numQubits", "=", 
        RowBox[{"StringLength", "@", 
         RowBox[{"First", "@", "generators"}]}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"rollingChars", "=", 
           RowBox[{"Characters", "/@", "generators"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"availableGens", "=", 
           RowBox[{"Range", "@", 
            RowBox[{"Length", "@", "generators"}]}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"whereWeAppliedH", "=", 
           RowBox[{"{", "}"}]}], ",", "appliedH", ",", 
          RowBox[{"whereWeAppliedS", "=", 
           RowBox[{"{", "}"}]}]}], "\[IndentingNewLine]", "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Do", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"rollingChars", ",", "availableGens", ",", "appliedH"}],
               "}"}], "=", 
             RowBox[{"fixXYatCol", "[", 
              RowBox[{
              "rollingChars", ",", "col", ",", "availableGens", ",", "False", 
               ",", 
               RowBox[{"OptionValue", "@", "\"\<bePedantic\>\""}]}], "]"}]}], 
            ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"appliedH", "==", "True"}], ",", 
              RowBox[{"AppendTo", "[", 
               RowBox[{"whereWeAppliedH", ",", "col"}], "]"}]}], "]"}]}], ",",
            "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"col", ",", 
             RowBox[{"Reverse", "@", 
              RowBox[{"Range", "@", 
               RowBox[{"Length", "@", 
                RowBox[{"First", "@", "rollingChars"}]}]}]}]}], "}"}]}], 
          "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"rollingChars", ",", "whereWeAppliedS"}], "}"}], "=", 
          RowBox[{"fixStrayYs", "[", "rollingChars", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"<|", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"\"\<generators\>\"", "->", 
            RowBox[{"sortGeneratorsByXPosition", "[", 
             RowBox[{"StringJoin", "/@", "rollingChars"}], "]"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"\"\<H\>\"", "->", 
            RowBox[{"ReplacePart", "[", 
             RowBox[{
              RowBox[{"ConstantArray", "[", 
               RowBox[{"False", ",", "numQubits"}], "]"}], ",", 
              RowBox[{"Thread", "@", 
               RowBox[{"Rule", "[", 
                RowBox[{"whereWeAppliedH", ",", "True"}], "]"}]}]}], "]"}]}], 
           ",", "\[IndentingNewLine]", 
           RowBox[{"\"\<S\>\"", "->", 
            RowBox[{"ReplacePart", "[", 
             RowBox[{
              RowBox[{"ConstantArray", "[", 
               RowBox[{"False", ",", "numQubits"}], "]"}], ",", 
              RowBox[{"Thread", "@", 
               RowBox[{"Rule", "[", 
                RowBox[{"whereWeAppliedS", ",", "True"}], "]"}]}]}], "]"}]}], 
           ",", "\[IndentingNewLine]", 
           RowBox[{"\"\<labels\>\"", "->", 
            RowBox[{"Range", "@", "numQubits"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
