Cell[BoxData[
 RowBox[{"DynamicModule", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"graphState", "=", 
      RowBox[{"Echo", "@", 
       RowBox[{"convertToGraphState", "[", 
        RowBox[{
         RowBox[{"fullGeneratorsFromCosetsGenerators", "@", 
          RowBox[{"{", "\"\<XYY\>\"", "}"}]}], ",", 
         RowBox[{"\"\<systemQubits\>\"", "->", 
          RowBox[{"{", 
           RowBox[{"1", ",", "2"}], "}"}]}]}], "]"}]}]}], ",", "graph", ",", 
     "positions", ",", "vertexLabels"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"graph", "=", 
     RowBox[{"adjacencyGraphFromPaulis", "@", "graphState"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"positions", "=", 
     RowBox[{"GraphEmbedding", "@", "graph"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"vertexLabels", "=", 
     RowBox[{"Echo", "@", 
      RowBox[{"Association", "@", 
       RowBox[{"AnnotationValue", "[", 
        RowBox[{"graph", ",", "VertexLabels"}], "]"}]}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Dynamic", "@", 
     RowBox[{"Graph", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Keys", "@", "vertexLabels"}], ",", 
       RowBox[{"EdgeList", "@", "graph"}], ",", "\[IndentingNewLine]", 
       RowBox[{"VertexCoordinates", "->", "positions"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"VertexLabels", "->", 
        RowBox[{"Normal", "@", "vertexLabels"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"VertexStyle", "->", 
        RowBox[{"AnnotationValue", "[", 
         RowBox[{"graph", ",", "VertexStyle"}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"VertexShapeFunction", "->", 
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"coord", ",", "v", ",", "e"}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"coord", "=", 
             RowBox[{"{", 
              RowBox[{"{", 
               RowBox[{"x", ",", "y"}], "}"}], "}"}]}], ",", 
            RowBox[{"v", "=", 
             RowBox[{"vertex", " ", "label"}]}]}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"EventHandler", "[", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"KeyExistsQ", "[", 
                  RowBox[{"state", ",", "v"}], "]"}], ",", "Red", ",", 
                 "LightBlue"}], "]"}], ",", 
               RowBox[{"Disk", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"0", ",", "0"}], "}"}], ",", ".45"}], "]"}]}], 
              "}"}], ",", 
             RowBox[{"ImageSize", "->", "36"}]}], "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Disk", "[", 
             RowBox[{"coord", ",", ".05"}], "]"}], ",", "\[IndentingNewLine]", 
            RowBox[{"\"\<MouseClicked\>\"", ":>", 
             RowBox[{"(", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"graphState", "=", 
                RowBox[{"Echo", "@", 
                 RowBox[{"localProjectionGraphState", "[", 
                  RowBox[{"graphState", ",", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Echo", "[", 
                    RowBox[{"#", ",", "\"\<projecting qubit:\>\""}], "]"}], 
                    "&"}], "@", 
                    RowBox[{
                    RowBox[{"vertexLabels", "[", "v", "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ",", 
                   "\"\<Z\>\""}], "]"}]}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"graph", "=", 
                RowBox[{"adjacencyGraphFromPaulis", "@", "graphState"}]}], 
               ";"}], "\[IndentingNewLine]", ")"}]}]}], "\[IndentingNewLine]",
            "]"}]}], "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", 
      "]"}]}]}]}], "\[IndentingNewLine]", "]"}]], "Input",
