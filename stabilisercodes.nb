         RowBox[{"\"\<n\>\"", "->", "n"}], ",", 
         RowBox[{"\"\<k\>\"", "->", "k"}], ",", 
         RowBox[{"\"\<d\>\"", "->", "d"}]}], "|>"}]}]}], "]"}]}], "\n", 
   "\[IndentingNewLine]", 
