     "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"::", "Section", "::"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", "Pauli", " ", "weight", " ", 
     RowBox[{"(", "fixed", ")"}]}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"ClearAll", "[", "pauliWeight", "]"}], "\n", 
   RowBox[{
    RowBox[{"pauliWeight", "[", "v_List", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"n", "=", 
         RowBox[{
          RowBox[{"Length", "[", "v", "]"}], "/", "2"}]}], ",", "x", ",", 
        "z"}], "}"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "z"}], "}"}], "=", 
        RowBox[{"TakeDrop", "[", 
         RowBox[{"v", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Boole", "[", 
           RowBox[{
            RowBox[{"#1", "==", "1"}], "||", 
            RowBox[{"#2", "==", "1"}]}], "]"}], "&"}], "@@@", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"x", ",", "z"}], "}"}], "]"}]}], "]"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Test", " ", "pauliWeight"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
