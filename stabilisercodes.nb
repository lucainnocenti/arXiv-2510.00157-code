           RowBox[{"mat", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", 
           RowBox[{"mat", "[", 
            RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "==", "0"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "mat", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", 
          RowBox[{"i", "+", "1"}], ",", 
          RowBox[{"Length", "[", "mat", "]"}]}], "}"}]}], "]"}], "]"}]}]}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"ClearAll", "[", "independentRank", "]"}], "\n", 
   RowBox[{
    RowBox[{"independentRank", "[", 
     RowBox[{"mat_", "?", "MatrixQ"}], "]"}], ":=", 
    RowBox[{"MatrixRank", "[", 
     RowBox[{"mat", ",", 
      RowBox[{"Modulus", "->", "2"}]}], "]"}]}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Test", " ", "allCommuteQ"}], "&"}], " ", "independentRank"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"mat1", "=", 
     RowBox[{"pauliBinary", "/@", 
      RowBox[{"{", 
       RowBox[{"\"\<XX\>\"", ",", "\"\<XZ\>\""}], "}"}]}]}], ";"}], " ", 
