  RowBox[{"pairsOfAbelian5qubitGens", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Subsets", "[", 
       RowBox[{
        RowBox[{"Rest", "@", 
         RowBox[{"allPauliStrings", "@", "5"}]}], ",", 
        RowBox[{"{", "2", "}"}]}], "]"}], "//", 
