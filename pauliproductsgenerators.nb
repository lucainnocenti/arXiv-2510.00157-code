 RowBox[{
  RowBox[{"ClearAll", "[", "applySToBinaryMatrices", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"applySToBinaryMatrices", "[", "mat_", "]"}], ":=", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"n", "=", 
        RowBox[{
         RowBox[{"Dimensions", "[", "mat", "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"x", "=", 
           RowBox[{"mat", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", 
              RowBox[{";;", 
               RowBox[{"n", "/", "2"}]}]}], "]"}], "]"}]}], ",", 
          RowBox[{"z", "=", 
           RowBox[{"mat", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", 
              RowBox[{
               RowBox[{
                RowBox[{"-", "n"}], "/", "2"}], ";;"}]}], "]"}], "]"}]}]}], 
         "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Table", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"MemberQ", "[", 
              RowBox[{
               RowBox[{"z", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "col"}], "]"}], "]"}], ",", "1"}], "]"}],
              ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"x", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "col"}], "]"}], "]"}], ",", 
               RowBox[{"Mod", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"x", "[", 
                   RowBox[{"[", 
                    RowBox[{"All", ",", "col"}], "]"}], "]"}], "+", 
                  RowBox[{"z", "[", 
                   RowBox[{"[", 
                    RowBox[{"All", ",", "col"}], "]"}], "]"}]}], ",", "2"}], 
                "]"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"x", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "col"}], "]"}], "]"}], ",", 
               RowBox[{"z", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "col"}], "]"}], "]"}]}], "}"}]}], "]"}], 
           ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"col", ",", 
             RowBox[{"n", "/", "2"}]}], "}"}]}], "\[IndentingNewLine]", "]"}],
          "//", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"Transpose", "[", 
             RowBox[{"#", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "All", ",", "1"}], "]"}], "]"}], "]"}], 
            ",", 
            RowBox[{"Transpose", "[", 
             RowBox[{"#", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "All", ",", "2"}], "]"}], "]"}], "]"}], 
            ",", "2"}], "]"}], "&"}]}]}], "\[IndentingNewLine]", "]"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
