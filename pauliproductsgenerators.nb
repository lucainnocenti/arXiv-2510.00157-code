   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"adjacencyMatrix", "=", 
        RowBox[{"ReplaceAll", "[", 
         RowBox[{
          RowBox[{"Characters", "/@", 
           RowBox[{"sortGeneratorsByXPosition", "@", 
            RowBox[{"graphState", "[", "\"\<generators\>\"", "]"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\"\<I\>\"", "->", "0"}], ",", 
            RowBox[{"\"\<X\>\"", "->", "0"}], ",", 
            RowBox[{"\"\<Z\>\"", "->", "1"}]}], "}"}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"labels", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"KeyExistsQ", "[", 
           RowBox[{"graphState", ",", "\"\<labels\>\""}], "]"}], ",", 
          RowBox[{"graphState", "@", "\"\<labels\>\""}], ",", 
          RowBox[{"Range", "@", 
           RowBox[{"StringLength", "@", 
            RowBox[{"First", "@", 
             RowBox[{"graphState", "[", "\"\<generators\>\"", "]"}]}]}]}]}], 
         "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"systemQubits", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"KeyExistsQ", "[", 
           RowBox[{"graphState", ",", "\"\<systemQubits\>\""}], "]"}], ",", 
          RowBox[{"graphState", "[", "\"\<systemQubits\>\"", "]"}], ",", 
          RowBox[{
           RowBox[{
           "Print", "[", 
            "\"\<Warning: you didn't specify the system qubits! Used {1} as \
default\>\"", "]"}], ";", 
           RowBox[{"{", "1", "}"}]}]}], "]"}]}]}], "\[IndentingNewLine]", 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"AdjacencyGraph", "[", 
