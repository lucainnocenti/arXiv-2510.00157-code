Cell[BoxData[{
 RowBox[{
  RowBox[{"inequivalentGenerators3q", "=", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"DeleteDuplicates", "[", 
      RowBox[{"sortString", "/@", 
       RowBox[{"Rest", "@", 
        RowBox[{"allPauliStrings", "@", "3"}]}]}], "]"}], ",", 
     RowBox[{
      RowBox[{"Not", "@", 
       RowBox[{"StringContainsQ", "[", 
        RowBox[{"#", ",", "\"\<Y\>\""}], "]"}]}], "&"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Rule", "[", 
      RowBox[{"#", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"GatherBy", "[", 
          RowBox[{"#", ",", 
           RowBox[{"Sort", "@*", "Characters"}]}], "]"}], "&"}], "@", 
        RowBox[{"Flatten", "@", 
         RowBox[{"stabiliserFromGenerators", "@", 
          RowBox[{"{", "#", "}"}]}]}]}]}], "]"}], "&"}], "/@", 
    "inequivalentGenerators3q"}], "//", "prettifyPaulis"}], "//", 
  RowBox[{"Map", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"#", "[", 
      RowBox[{"[", "1", "]"}], "]"}], "->", 
     RowBox[{"Column", "@", 
      RowBox[{"#", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}]}], "&"}], "]"}]}]}], "Input",
