Cell[TextData[{
 "Can we reproduce the observed max rank numbers with explicit formulas? fix \
n=3\n\nfor t=4, there\[CloseCurlyQuote]s 1 gen, rank is maximised by XXXZ, \
which gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["3", "4"], "-", "1"}], ")"}], "/", "2"}], "=", "40"}], 
   TraditionalForm]],ExpressionUUID->"7ab1393f-97ed-c240-9744-2e394c47b6bf"],
 "\nfor t=5, 2 gens, max for {IIIXZ, XXZII}, rank is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["3", "3"], "-", "1"}], ")"}], "2"], 
    FractionBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["3", "2"], "-", "1"}], ")"}], "2"]}], TraditionalForm]],
  ExpressionUUID->"422996fa-0b6e-bb40-a2cb-1bff4a7bb147"],
 "=52\nfor t=6, 3 gens, max for {XZIIII, IIXZII, IIIIXZ}, rank ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{
        SuperscriptBox["3", "2"], "-", "1"}], "2"], ")"}], "3"], "=", 
    RowBox[{
     SuperscriptBox["4", "3"], "=", "64"}]}], TraditionalForm]],
  ExpressionUUID->"16480168-62f6-7347-afcf-35c28bb49fa9"],
 "\n\nFor n=4, we\[CloseCurlyQuote]d thus get\nt=5, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{
      SuperscriptBox["3", "5"], "-", "1"}], "2"], "=", "121"}], 
   TraditionalForm]],ExpressionUUID->"933fcc10-1539-7048-aa70-fb51b23eaac9"],
 "\nt=6, {XXZIII,IIIXXZ}, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{
        SuperscriptBox["3", "3"], "-", "1"}], "2"], ")"}], "2"], "=", "169"}],
    TraditionalForm]],ExpressionUUID->"240bbffb-e29f-e340-ae05-6a37d577f577"],
 "\nt=7, {XZIIIII,IIXZIII,IIIIXXZ}, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox[
        RowBox[{
         SuperscriptBox["3", "2"], "-", "1"}], "2"], ")"}], "2"], 
     RowBox[{"(", 
      FractionBox[
       RowBox[{
        SuperscriptBox["3", "3"], "-", "1"}], "2"], ")"}]}], "=", "208"}], 
   TraditionalForm]],ExpressionUUID->"887999cf-65f7-6546-b9d4-bed9c5accee7"],
 "\nt=8, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{
        SuperscriptBox["3", "2"], "-", "1"}], "2"], ")"}], "4"], "=", 
    SuperscriptBox["4", "4"]}], TraditionalForm]],ExpressionUUID->
  "98a186a2-9c35-cb4d-80b2-a060b3a342f2"]
}], "Text",
 CellChangeTimes->{{3.961407830169594*^9, 3.96140811944027*^9}, {
  3.961408208538965*^9, 
  3.96140834948608*^9}},ExpressionUUID->"8ee77fee-709c-8b4b-8d19-\
e882c2e7f508"],

Cell[CellGroupData[{

Cell[BoxData[
 FormBox[
  SuperscriptBox[
   RowBox[{"(", 
    FractionBox[
     RowBox[{
      SuperscriptBox["3", "2"], "-", "1"}], "2"], ")"}], "3"], 
  TraditionalForm]], "Input",
 CellChangeTimes->{{3.961408123872593*^9, 3.961408136095234*^9}, {
  3.9614082951967964`*^9, 3.96140832815927*^9}},
