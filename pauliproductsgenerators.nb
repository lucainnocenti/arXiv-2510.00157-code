Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"sortByCol", "[", 
    RowBox[{"ops", ":", 
     RowBox[{"{", "__String", "}"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Transpose", "[", 
     RowBox[{"Sort", "@", 
      RowBox[{"Transpose", "[", 
       RowBox[{"Characters", "/@", "ops"}], "]"}]}], "]"}], "//", 
    RowBox[{"Map", "@", "StringJoin"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"sortByZInCols", "[", 
     RowBox[{"ops", ":", 
      RowBox[{"{", "__String", "}"}]}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{
       RowBox[{"SortBy", "[", 
        RowBox[{
         RowBox[{"Flatten", "@", 
          RowBox[{"Position", "[", 
           RowBox[{"#", ",", "\"\<Z\>\""}], "]"}]}], "&"}], "]"}], "@", 
       RowBox[{"Transpose", "[", 
        RowBox[{"Characters", "/@", "ops"}], "]"}]}], "]"}], "//", 
     RowBox[{"Map", "@", "StringJoin"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"arrangeByZ", "[", 
    RowBox[{"ops", ":", 
     RowBox[{"{", "__String", "}"}]}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"allops", "=", 
       RowBox[{"Rest", "@", 
        RowBox[{"allStringsFromAbGenerators", "@", "ops"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"sortByZInCols", "@", 
      RowBox[{"SortBy", "[", 
       RowBox[{"allops", ",", 
        RowBox[{
         RowBox[{"StringCount", "[", 
          RowBox[{"#", ",", "\"\<Z\>\""}], "]"}], "&"}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"extractZPattern", "[", 
    RowBox[{"ops", ":", 
     RowBox[{"{", "__String", "}"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"StringPosition", "[", 
       RowBox[{"#", ",", "\"\<Z\>\""}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "1"}], "]"}], "]"}], "&"}], "/@", 
    RowBox[{"arrangeByZ", "@", "ops"}]}]}], ";"}]}], "Input",
