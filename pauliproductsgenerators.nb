         RowBox[{"UpTo", "@", "10"}]}], "]"}], "&"}], "@", 
      RowBox[{"DeleteDuplicates", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{"pairsOfAbelian5qubitGens", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"noRepeatedIs", "@", "#"}], "&&", 
            RowBox[{
             RowBox[{"zFreeCentralizerFromGenerators", "@", "#"}], "==", 
             "centerSize"}]}], "&"}]}], "]"}], "//", 
        RowBox[{"Map", "[", 
         RowBox[{
