Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"::", "Section", "::"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"1.", " ", "Pauli"}], "\[RightArrow]", 
    RowBox[{"binary", " ", "symplectic", " ", "vector"}]}], "*)"}], 
  RowBox[{
   RowBox[{"ClearAll", "[", "pauliBinary", "]"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"pauliBinary", "[", "s_String", "]"}], "/;", 
     RowBox[{"StringMatchQ", "[", 
      RowBox[{"s", ",", 
       RowBox[{"RegularExpression", "[", "\"\<[IXYZ]+\>\"", "]"}]}], "]"}]}], 
    ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"c", "=", 
        RowBox[{"Characters", "[", "s", "]"}]}], "}"}], ",", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"c", "/.", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<I\>\"", "->", "0"}], ",", 
           RowBox[{"\"\<Z\>\"", "->", "0"}], ",", 
           RowBox[{"\"\<X\>\"", "->", "1"}], ",", 
           RowBox[{"\"\<Y\>\"", "->", "1"}]}], "}"}]}], ",", 
        RowBox[{"(*", 
         RowBox[{"x", " ", "bits"}], "*)"}], 
        RowBox[{"c", "/.", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<I\>\"", "->", "0"}], ",", 
           RowBox[{"\"\<X\>\"", "->", "0"}], ",", 
           RowBox[{"\"\<Z\>\"", "->", "1"}], ",", 
           RowBox[{"\"\<Y\>\"", "->", "1"}]}], "}"}]}]}], "   ", 
       RowBox[{"(*", 
        RowBox[{"z", " ", "bits"}], "*)"}], "]"}]}], "]"}]}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Test", " ", "pauliBinary"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<pauliBinary[\\\"IXYZ\\\"] == \>\"", ",", 
      RowBox[{"pauliBinary", "[", "\"\<IXYZ\>\"", "]"}], ",", 
      "\"\<   (expect {0,1,1,0, 0,0,1,1})\>\""}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"::", "Section", "::"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"2.", " ", "Symplectic", " ", "inner", " ", "product"}], "*)"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"ClearAll", "[", "symplecticProduct", "]"}], "\n", 
   RowBox[{
    RowBox[{"symplecticProduct", "[", 
     RowBox[{"u_List", ",", "v_List"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"n", "=", 
         RowBox[{
          RowBox[{"Length", "[", "u", "]"}], "/", "2"}]}], ",", "xu", ",", 
        "zu", ",", "xv", ",", "zv"}], "}"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"xu", ",", "zu"}], "}"}], "=", 
        RowBox[{"TakeDrop", "[", 
         RowBox[{"u", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"xv", ",", "zv"}], "}"}], "=", 
        RowBox[{"TakeDrop", "[", 
         RowBox[{"v", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Mod", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"xu", ".", "zv"}], "+", 
          RowBox[{"zu", ".", "xv"}]}], ",", "2"}], "]"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Test", " ", 
     RowBox[{"symplecticProduct", ":", 
      RowBox[{
       RowBox[{
       "X", " ", "on", " ", "qubit", " ", "1", "  ", "vs", "  ", "Z", " ", 
        "on", " ", "qubit", " ", "1", " ", "anticommutes"}], 
       "\[DoubleRightArrow]", "1"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vX1", "=", 
     RowBox[{"pauliBinary", "[", "\"\<XIII\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"vZ1", "=", 
     RowBox[{"pauliBinary", "[", "\"\<ZIII\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
