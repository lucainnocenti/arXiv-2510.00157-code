                 RowBox[{
                  RowBox[{"graphState", "[", "\"\<S\>\"", "]"}], "[", 
                  RowBox[{"[", "idx", "]"}], "]"}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{"{", 
                  RowBox[{"Style", "[", 
                   RowBox[{"\"\<(S)\>\"", ",", "Bold", ",", "Red"}], "]"}], 
                  "}"}], ",", "\[IndentingNewLine]", 
                 RowBox[{"{", "}"}]}], "\[IndentingNewLine]", "]"}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"Sequence", "@@", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"graphState", "[", "\"\<H\>\"", "]"}], "[", 
                  RowBox[{"[", "idx", "]"}], "]"}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{"{", 
                  RowBox[{"Style", "[", 
                   RowBox[{"\"\<(H)\>\"", ",", "Bold", ",", "Blue"}], "]"}], 
                  "}"}], ",", "\[IndentingNewLine]", 
                 RowBox[{"{", "}"}]}], "\[IndentingNewLine]", "]"}]}]}], 
             "\[IndentingNewLine]", "}"}]}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"idx", ",", 
            RowBox[{"Range", "@", 
             RowBox[{"Length", "@", "labels"}]}]}], "}"}]}], 
         "\[IndentingNewLine]", "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"GraphLayout", "->", "\"\<CircularEmbedding\>\""}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"VertexStyle", "->", 
        RowBox[{"Table", "[", 
