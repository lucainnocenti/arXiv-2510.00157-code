Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"splitByLocalGens", "[", 
     RowBox[{
      RowBox[{"pauliStrings", ":", 
       RowBox[{"{", "__String", "}"}]}], ",", "n_Integer", ",", "m_Integer"}],
      "]"}], ":=", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"localPaulisRight", "=", 
         RowBox[{"StringTake", "[", 
          RowBox[{
           RowBox[{"Select", "[", 
            RowBox[{"pauliStrings", ",", 
             RowBox[{
              RowBox[{"And", "@@", 
               RowBox[{"Thread", "[", 
