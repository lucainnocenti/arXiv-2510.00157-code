          RowBox[{"2", " ", "n"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"commuting", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"allPaulis", ",", 
          RowBox[{"Function", "[", 
