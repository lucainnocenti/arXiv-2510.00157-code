Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "localProjectionGraphState", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"localProjectionGraphState", "[", 
     RowBox[{
      RowBox[{"stabilisers", ":", 
       RowBox[{"{", "__String", "}"}]}], ",", "pos_Integer", ",", 
      "basis_String"}], "]"}], ":=", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"chars", "=", 
        RowBox[{"Characters", "/@", 
         RowBox[{"allStringsFromAbGenerators", "@", "stabilisers"}]}]}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", "leftoverGens", "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"leftoverGens", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"ReplacePart", "[", 
             RowBox[{"#", ",", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"_", ",", "pos"}], "}"}], "->", "\"\<I\>\""}]}], 
             "]"}], "&"}], "@", 
           RowBox[{"Select", "[", 
            RowBox[{"chars", ",", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "pos", "]"}], "]"}], "==", "basis"}], "||", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "pos", "]"}], "]"}], "==", "\"\<I\>\""}]}], 
              "&"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"leftoverGens", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"ReplacePart", "[", 
              RowBox[{"#", ",", 
               RowBox[{"pos", "->", "\"\<X\>\""}]}], "]"}], "&"}], "@", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{"\"\<I\>\"", ",", 
              RowBox[{"StringLength", "@", 
               RowBox[{"First", "@", "leftoverGens"}]}]}], "]"}]}]}], "]"}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"Echo", "[", "leftoverGens", "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"leftoverGens", "=", 
          RowBox[{"independentGenerators", "[", 
           RowBox[{"StringJoin", "/@", "leftoverGens"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"convertToGraphState", "@", "leftoverGens"}]}]}], 
       "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"localProjectionGraphState", "[", 
    RowBox[{
    "graphState_Association", ",", "pos_Integer", ",", "basis_String"}], 
    "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"updatedBasis", "=", 
        RowBox[{"Which", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"graphState", "[", "\"\<S\>\"", "]"}], "[", 
            RowBox[{"[", "pos", "]"}], "]"}], "&&", 
           RowBox[{
            RowBox[{"graphState", "[", "\"\<H\>\"", "]"}], "[", 
            RowBox[{"[", "pos", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"basis", "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\"\<Y\>\"", "->", "\"\<Z\>\""}], ",", 
             RowBox[{"\"\<Z\>\"", "->", "\"\<Y\>\""}]}], "}"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"graphState", "[", "\"\<S\>\"", "]"}], "[", 
           RowBox[{"[", "pos", "]"}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"basis", "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\"\<Y\>\"", "->", "\"\<X\>\""}], ",", 
             RowBox[{"\"\<X\>\"", "->", "\"\<Y\>\""}]}], "}"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"graphState", "[", "\"\<H\>\"", "]"}], "[", 
           RowBox[{"[", "pos", "]"}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"basis", "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\"\<Z\>\"", "->", "\"\<X\>\""}], ",", 
             RowBox[{"\"\<X\>\"", "->", "\"\<Z\>\""}]}], "}"}]}], ",", 
          "\[IndentingNewLine]", "True", ",", "\[IndentingNewLine]", 
          "basis"}], "\[IndentingNewLine]", "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"updatedLocalGates", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Delete", "[", 
           RowBox[{
            RowBox[{"graphState", "[", "\"\<S\>\"", "]"}], ",", "pos"}], 
           "]"}], ",", 
          RowBox[{"Delete", "[", 
           RowBox[{
            RowBox[{"graphState", "[", "\"\<H\>\"", "]"}], ",", "pos"}], 
           "]"}]}], "}"}]}]}], "\[IndentingNewLine]", "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"<|", 
        RowBox[{"#", ",", "\[IndentingNewLine]", 
         RowBox[{"\"\<S\>\"", "->", 
          RowBox[{"Xor", "@@@", 
           RowBox[{"Thread", "@", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"updatedLocalGates", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{"#", "[", "\"\<S\>\"", "]"}]}], "}"}]}]}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"\"\<H\>\"", "->", 
          RowBox[{"Xor", "@@@", 
           RowBox[{"Thread", "@", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"updatedLocalGates", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", 
              RowBox[{"#", "[", "\"\<H\>\"", "]"}]}], "}"}]}]}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"KeyExistsQ", "[", 
            RowBox[{"graphState", ",", "\"\<labels\>\""}], "]"}], ",", 
           RowBox[{"\"\<labels\>\"", "->", 
            RowBox[{"Delete", "[", 
             RowBox[{
              RowBox[{"graphState", "[", "\"\<labels\>\"", "]"}], ",", 
              "pos"}], "]"}]}], ",", 
           RowBox[{"{", "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"KeyExistsQ", "[", 
            RowBox[{"graphState", ",", "\"\<systemQubits\>\""}], "]"}], ",", 
           RowBox[{"\"\<systemQubits\>\"", "->", 
            RowBox[{"DeleteCases", "[", 
             RowBox[{
              RowBox[{"graphState", "[", "\"\<systemQubits\>\"", "]"}], ",", 
              RowBox[{
               RowBox[{"graphState", "[", "\"\<labels\>\"", "]"}], "[", 
               RowBox[{"[", "pos", "]"}], "]"}]}], "]"}]}], ",", 
           RowBox[{"{", "}"}]}], "]"}]}], "\[IndentingNewLine]", "|>"}], 
       "&"}], "@", 
      RowBox[{"localProjectionGraphState", "[", 
       RowBox[{
        RowBox[{"graphState", "[", "\"\<generators\>\"", "]"}], ",", "pos", 
        ",", "updatedBasis"}], "]"}]}]}], "\[IndentingNewLine]", 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9617754078484135`*^9, 3.961775411773126*^9}, {
   3.9617754471149483`*^9, 3.9617756354509945`*^9}, {3.961775669875323*^9, 
